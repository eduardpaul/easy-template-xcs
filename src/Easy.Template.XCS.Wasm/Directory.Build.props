<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- keep the build variants apart so they never share intermediate files -->
  <PropertyGroup Condition="'$(RunAOTCompilation)' == 'true'">
    <BaseIntermediateOutputPath>obj/aot/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/aot/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(UseMonoRuntime)' == 'false'">
    <!-- CoreCLR on WebAssembly (.NET 11+) -->
    <BaseIntermediateOutputPath>obj/coreclr/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/coreclr/</BaseOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- neither build may pick up the other one's generated sources -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
