<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(CanTargetNet11)' == 'true'">$(TargetFrameworks);net11.0</TargetFrameworks>
    <RootNamespace>Easy.Template.XCS</RootNamespace>
    <AssemblyName>Easy.Template.XCS</AssemblyName>
    <Version>1.0.0</Version>
    <Copyright>Easy.Template.XCS</Copyright>
    <Company>Easy.Template.XCS</Company>
    <Authors>alonrbar and easy-template-x contributors; Eduard Paul Lakida</Authors>
    <PackageProjectUrl>https://github.com/eduardpaul/easy-template-xcs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eduardpaul/easy-template-xcs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <PackageId>Easy.Template.XCS</PackageId>
    <IsPackable>true</IsPackable>
    <PackageTags>Word;docx;Templates;Document;OpenXml</PackageTags>
    <Description>Generate docx documents from templates. .NET port of easy-template-x (https://github.com/alonrbar/easy-template-x).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Easy.Template.XCS.Test" />
  </ItemGroup>

</Project>
