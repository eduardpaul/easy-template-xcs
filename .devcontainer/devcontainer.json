{
    "name": "Easy.Template.XCS Dev container (dotnet 10)",
    "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
    "features": {
        "ghcr.io/devcontainers/features/common-utils:2": {
            "installZsh": true,
            "installOhMyZsh": true,
            "upgradePackages": true,
            "username": "vscode",
            "userUid": "automatic",
            "userGid": "automatic"
        },
        "ghcr.io/devcontainers/features/github-cli:1": {
            "version": "latest"
        }
    },
    "workspaceFolder": "/workspaces/easy-template-xcs",
    "postCreateCommand": "cd src && dotnet restore && dotnet build && dotnet test",
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "settings": {
                "dotnet.defaultSolution": "src/Easy.Template.XCS.sln"
            },
            "extensions": [
                "ms-dotnettools.csdevkit",
                "ms-dotnettools.csharp",
                "yuenm18.ooxml-viewer",
                "GitHub.vscode-pull-request-github"
            ]
        }
    }
}
